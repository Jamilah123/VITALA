# Copy to .env and fill in locally. NEVER commit .env. Everything runs without keys in extractive (quote-only) mode.

# ---- LLM provider: azure_openai | anthropic | openai_compatible | extractive
VITALA_LLM_PROVIDER=extractive
VITALA_RETRIEVAL_MODE=hybrid

# Azure OpenAI (used for the evaluation runs in results/evaluation/)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=<deployment-name>
AZURE_OPENAI_API_KEY=<your-key>
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Anthropic:            ANTHROPIC_API_KEY=<your-key>
# OpenAI-compatible:    OPENAI_API_KEY=<your-key>  VITALA_OPENAI_MODEL=<model>  VITALA_OPENAI_BASE_URL=<url>

# ---- optional: cost estimates in the evaluation (USD per 1M tokens of YOUR deployment)
# VITALA_PRICE_INPUT_PER_1M=
# VITALA_PRICE_OUTPUT_PER_1M=

# ---- safety / governance switches
VITALA_REQUIRE_CLINICAL_APPROVAL=0   # 1 = only sources marked APPROVED in data/source_registry.csv are indexed
VITALA_INDEX_DOSING=0                # 1 = also index dose-titration references (off by policy)
VITALA_DEBUG=0                       # 1 = developer diagnostics in the API/UI. Never enable for patients.
VITALA_LOG=0                         # 1 = append minimal interaction logs to logs/ (no patient data)
