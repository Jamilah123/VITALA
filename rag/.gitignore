# ---- secrets (never commit) -------------------------------------------------
.env
.env.*
!.env.example

# ---- Python / editors ---------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/
logs/
