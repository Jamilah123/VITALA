# Copy this file to .env to change the defaults. Every setting is optional.
# Never put real secrets in this example file.

# SQLite file. A relative path is resolved from the backend folder.
VITALA_DATABASE_PATH=vitala.db

# Frontend origins allowed to call the API, as a JSON list. Empty by default.
VITALA_CORS_ORIGINS=["http://localhost:5173"]

# VITALA RAG chatbot service (rag/). The backend only calls it over HTTP.
VITALA_RAG_URL=http://127.0.0.1:8001
VITALA_RAG_TIMEOUT_SECONDS=60

# Fernet key that encrypts national IDs and insurance member numbers. Without it
# those two fields cannot be saved. Generate one locally (never commit it):
#   .\.venv\Scripts\python.exe -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# VITALA_FIELD_ENCRYPTION_KEY=

# Database copies made before a migration alters an existing table.
VITALA_BACKUP_DIR=db_backups
