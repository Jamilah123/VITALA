# Copy this file to .env to change the defaults. Every setting is optional.
# Never put real secrets in this example file.

# SQLite file. A relative path is resolved from the backend folder.
VITALA_DATABASE_PATH=vitala.db

# Frontend origins allowed to call the API, as a JSON list. Empty by default.
VITALA_CORS_ORIGINS=["http://localhost:5173"]

# Later chatbot milestone. Not read by the backend yet.
# ANTHROPIC_API_KEY=your-api-key-here
